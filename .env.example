# Copie para .env antes de subir o compose: cp .env.example .env

DJANGO_SECRET_KEY=troque-esta-chave
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

POSTGRES_DB=advicetodo
POSTGRES_USER=advicetodo
POSTGRES_PASSWORD=advicetodo
DATABASE_URL=postgres://advicetodo:advicetodo@db:5432/advicetodo

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# Integracao externa (feriados nacionais)
HOLIDAYS_BASE_URL=https://brasilapi.com.br/api/feriados/v1
HOLIDAYS_TIMEOUT=5
HOLIDAYS_CACHE_SECONDS=86400
